// The administrator running the installer authorizes this desktop account
// to authenticate changes to Cam Toggle's restoration setting only.
polkit.addAdminRule(function(action, subject) {
    if (action.id === "org.dms.camtoggle.configure-restore" &&
        subject.user === "@CAMTOGGLE_USER@" && subject.local && subject.active) {
        return ["unix-user:@CAMTOGGLE_USER@"];
    }
});
