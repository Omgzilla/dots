#!/bin/bash
menu=("󰌾 lock
 suspend
󰍃 logout
󰤁 reboot
󰐥 shutdown")

choice="$(echo -e "${menu[@]}" | rofi -dmenu -l 6 -p "󰩈 Exit: ")"
[ -z "$choice" ] && exit 0
case "$choice" in
	󰌾*)
		#pidof hyprlock >/dev/null || hyprlock
    dms ipc call lock lock
		;;
   )
    dms ipc call lock lockAndOutputsOff
		;;
	󰍃*)
		uwsm stop
		;;
	󰤁*)
		systemctl reboot
		;;
	󰐥*)
		systemctl poweroff
		;;
	*)
		exit 1
		;;
esac



